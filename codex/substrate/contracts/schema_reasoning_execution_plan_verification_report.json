{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex/substrate/contracts/schema_reasoning_execution_plan_verification_report.json",
  "id": "schema_reasoning_execution_plan_verification_report",
  "artifact_kind": "contract",
  "version": "0.1",
  "status": "NORMATIVE",
  "description": "JSON Schema for reasoning_execution_plan_verification_report_v0, the static semantic verification report over reasoning_execution_plan_v0 before any scheduler, launcher, provider router, or fan-out runner consumes plan IR.",
  "purpose": "The report checks plan-level graph semantics, embedded packet manifests, ready-set derivation, status derivation, context-policy scope, dry-run side-effect invariants, and recovery posture. It is non-runtime and carries witness payloads for actionable defects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "plan_status",
    "source_refs",
    "ok",
    "checks",
    "issues",
    "witnesses"
  ],
  "properties": {
    "schema_version": {
      "const": "reasoning_execution_plan_verification_report_v0"
    },
    "plan_id": {
      "$ref": "#/$defs/nullable_string"
    },
    "plan_status": {
      "$ref": "#/$defs/nullable_string"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_schema_valid",
        "embedded_packet_manifests_valid",
        "node_ids_unique",
        "edge_endpoints_exist",
        "acyclic",
        "upstream_dependency_consistency",
        "ready_set_consistency",
        "status_derivation_consistency",
        "context_policy_scope",
        "dry_run_side_effect_consistency",
        "recovery_protocol_present"
      ],
      "properties": {
        "plan_schema_valid": {
          "$ref": "#/$defs/check_status"
        },
        "embedded_packet_manifests_valid": {
          "$ref": "#/$defs/check_status"
        },
        "node_ids_unique": {
          "$ref": "#/$defs/check_status"
        },
        "edge_endpoints_exist": {
          "$ref": "#/$defs/check_status"
        },
        "acyclic": {
          "$ref": "#/$defs/check_status"
        },
        "upstream_dependency_consistency": {
          "$ref": "#/$defs/check_status"
        },
        "ready_set_consistency": {
          "$ref": "#/$defs/check_status"
        },
        "status_derivation_consistency": {
          "$ref": "#/$defs/check_status"
        },
        "context_policy_scope": {
          "$ref": "#/$defs/check_status"
        },
        "dry_run_side_effect_consistency": {
          "$ref": "#/$defs/check_status"
        },
        "recovery_protocol_present": {
          "$ref": "#/$defs/check_status"
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "witnesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/witness"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "check_status": {
      "enum": [
        "pass",
        "warn",
        "fail",
        "not_applicable"
      ]
    },
    "severity": {
      "enum": [
        "warning",
        "error"
      ]
    },
    "witness": {
      "type": "object",
      "additionalProperties": true
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "path",
        "message",
        "witness"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        },
        "witness": {
          "$ref": "#/$defs/witness"
        }
      }
    }
  }
}
