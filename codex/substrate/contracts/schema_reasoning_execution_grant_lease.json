{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex/substrate/contracts/schema_reasoning_execution_grant_lease.json",
  "id": "schema_reasoning_execution_grant_lease",
  "artifact_kind": "contract",
  "version": "0.1",
  "status": "NORMATIVE",
  "description": "JSON Schema for reasoning_execution_grant_lease_v0, the caveated capability lease between reasoning_execution_authority_envelope_v0 and reasoning_execution_receipt_v0.",
  "purpose": "The grant lease records node-scoped, caveated execution capability eligibility without issuing runtime authority. It binds a grantable authority-envelope node decision to context, artifact, side-effect, receipt, and provenance caveats. v0 never materializes a grant, authorizes launch, dispatches providers or models, invokes tools, writes artifacts, or records actual execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_refs",
    "grant_id",
    "node_id",
    "authority_envelope_hash",
    "node_authority_decision",
    "lease_posture",
    "capabilities",
    "caveats",
    "provenance_materials",
    "evaluation",
    "dry_run",
    "status",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "reasoning_execution_grant_lease_v0"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "grant_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "node_id": {
      "$ref": "#/$defs/non_empty_string"
    },
    "authority_envelope_hash": {
      "$ref": "#/$defs/sha256_string"
    },
    "node_authority_decision": {
      "enum": [
        "no_grant_needed",
        "grantable",
        "denied",
        "invalid"
      ]
    },
    "lease_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "grant_materialized",
        "launch_authorized",
        "reason"
      ],
      "properties": {
        "mode": {
          "const": "dry_run_grant_lease_preflight"
        },
        "grant_materialized": {
          "const": false
        },
        "launch_authorized": {
          "const": false
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "grantable",
        "denied"
      ],
      "properties": {
        "requested": {
          "$ref": "#/$defs/capability_array"
        },
        "grantable": {
          "$ref": "#/$defs/capability_array"
        },
        "denied": {
          "$ref": "#/$defs/capability_array"
        }
      }
    },
    "caveats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_context_classes",
        "forbidden_context_classes",
        "effective_context_bound",
        "output_artifact_kind",
        "schema_or_standard",
        "side_effect_ceiling",
        "receipt_required",
        "receipt_schema",
        "single_use",
        "expires_at"
      ],
      "properties": {
        "allowed_context_classes": {
          "$ref": "#/$defs/string_array"
        },
        "forbidden_context_classes": {
          "$ref": "#/$defs/string_array"
        },
        "effective_context_bound": {
          "$ref": "#/$defs/string_array"
        },
        "output_artifact_kind": {
          "$ref": "#/$defs/nullable_string"
        },
        "schema_or_standard": {
          "$ref": "#/$defs/nullable_string"
        },
        "side_effect_ceiling": {
          "$ref": "#/$defs/side_effect_ceiling"
        },
        "receipt_required": {
          "const": true
        },
        "receipt_schema": {
          "const": "reasoning_execution_receipt_v0"
        },
        "single_use": {
          "const": true
        },
        "expires_at": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "provenance_materials": {
      "$ref": "#/$defs/provenance_materials"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "dry_run": {
      "const": true
    },
    "status": {
      "enum": [
        "eligible_unissued",
        "denied",
        "invalid_grant_lease"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "eligible_unissued"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "node_authority_decision": {
            "const": "grantable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_grant_lease"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        },
        "required": [
          "dry_run"
        ]
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "model_dispatch": {
                "const": false
              },
              "provider_dispatch": {
                "const": false
              },
              "runtime_execution": {
                "const": false
              },
              "writes": {
                "const": false
              }
            }
          },
          "lease_posture": {
            "properties": {
              "launch_authorized": {
                "const": false
              },
              "grant_materialized": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256_string": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_sha256_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capability_array": {
      "type": "array",
      "items": {
        "enum": [
          "context_read",
          "model_dispatch",
          "provider_dispatch",
          "tool_invocation",
          "local_write",
          "commit",
          "external_action"
        ]
      }
    },
    "side_effect_ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "writes_allowed",
        "commit_allowed",
        "external_action_allowed"
      ],
      "properties": {
        "read_only": {
          "type": "boolean"
        },
        "writes_allowed": {
          "$ref": "#/$defs/string_array"
        },
        "commit_allowed": {
          "type": "boolean"
        },
        "external_action_allowed": {
          "type": "boolean"
        }
      }
    },
    "provenance_materials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_envelope_hash",
        "schedule_preflight_hash",
        "candidate_lineage_hash",
        "replay_scope_hash",
        "execution_plan_hash",
        "packet_manifest_hash",
        "authority_envelope_input_hash"
      ],
      "properties": {
        "authority_envelope_hash": {
          "$ref": "#/$defs/sha256_string"
        },
        "schedule_preflight_hash": {
          "$ref": "#/$defs/nullable_sha256_string"
        },
        "candidate_lineage_hash": {
          "$ref": "#/$defs/nullable_sha256_string"
        },
        "replay_scope_hash": {
          "$ref": "#/$defs/nullable_sha256_string"
        },
        "execution_plan_hash": {
          "$ref": "#/$defs/nullable_sha256_string"
        },
        "packet_manifest_hash": {
          "$ref": "#/$defs/nullable_sha256_string"
        },
        "authority_envelope_input_hash": {
          "$ref": "#/$defs/nullable_sha256_string"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_dispatch",
        "provider_dispatch",
        "runtime_execution",
        "writes"
      ],
      "properties": {
        "model_dispatch": {
          "type": "boolean"
        },
        "provider_dispatch": {
          "type": "boolean"
        },
        "runtime_execution": {
          "type": "boolean"
        },
        "writes": {
          "type": "boolean"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "path",
        "message",
        "witness"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        },
        "witness": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
