{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex/substrate/contracts/schema_reasoning_contract_packet_manifest.json",
  "id": "schema_reasoning_contract_packet_manifest",
  "artifact_kind": "contract",
  "version": "0.1",
  "status": "NORMATIVE",
  "description": "JSON Schema for reasoning_contract_packet_manifest_v0, the dry-run intermediate representation emitted from std_node_reasoning meta.reasoning_contract overlays before any launcher, provider, fan-out, or runtime consumer may act on them.",
  "purpose": "The manifest lowers constitutional node metadata into a checkable launch-planning packet. It records context injection/withholding, artifact requirements, blocked conditions, side-effect policy, trace routing, and proof that no model/provider/runtime dispatch occurred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "node_id",
    "node_path",
    "source_refs",
    "evaluation",
    "dry_run",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "reasoning_contract_packet_manifest_v0"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "node_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_class",
        "mission_role",
        "authority_tier",
        "context_mode"
      ],
      "properties": {
        "role_class": {
          "$ref": "#/$defs/nullable_string"
        },
        "mission_role": {
          "$ref": "#/$defs/nullable_string"
        },
        "authority_tier": {
          "$ref": "#/$defs/nullable_string"
        },
        "context_mode": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inject",
        "reference_only",
        "withhold",
        "redact",
        "forbidden",
        "max_context_tokens",
        "leakage_mode"
      ],
      "properties": {
        "inject": {
          "$ref": "#/$defs/string_array"
        },
        "reference_only": {
          "$ref": "#/$defs/string_array"
        },
        "withhold": {
          "$ref": "#/$defs/string_array"
        },
        "redact": {
          "$ref": "#/$defs/string_array"
        },
        "forbidden": {
          "$ref": "#/$defs/string_array"
        },
        "max_context_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "leakage_mode": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_artifacts",
        "optional_artifacts",
        "forbidden_artifacts",
        "available_artifacts",
        "required_present",
        "required_missing",
        "artifact_presence_mode",
        "output_artifact_kind",
        "schema_or_standard",
        "citation_requirements",
        "confidence_shape",
        "failure_shape"
      ],
      "properties": {
        "required_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "optional_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "forbidden_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "available_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "required_present": {
          "$ref": "#/$defs/string_array"
        },
        "required_missing": {
          "$ref": "#/$defs/string_array"
        },
        "artifact_presence_mode": {
          "enum": [
            "not_evaluated",
            "evaluated"
          ]
        },
        "output_artifact_kind": {
          "$ref": "#/$defs/nullable_string"
        },
        "schema_or_standard": {
          "$ref": "#/$defs/nullable_string"
        },
        "citation_requirements": {
          "$ref": "#/$defs/string_array"
        },
        "confidence_shape": {
          "$ref": "#/$defs/nullable_string"
        },
        "failure_shape": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "blocked_conditions": {
      "$ref": "#/$defs/string_array"
    },
    "blocked_if_present": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_classes",
        "artifacts"
      ],
      "properties": {
        "context_classes": {
          "$ref": "#/$defs/string_array"
        },
        "artifacts": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocked_by_item"
      }
    },
    "freshness_requirements": {
      "$ref": "#/$defs/string_array"
    },
    "authority_requirements": {
      "$ref": "#/$defs/string_array"
    },
    "oracle_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_check",
        "soft_review",
        "human_review_gate"
      ],
      "properties": {
        "deterministic_check": {
          "$ref": "#/$defs/string_array"
        },
        "soft_review": {
          "$ref": "#/$defs/string_array"
        },
        "human_review_gate": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "learning_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dossier_reads",
        "dossier_writes",
        "learning_ledger_rows",
        "mutation_gate",
        "no_learning_when"
      ],
      "properties": {
        "dossier_reads": {
          "$ref": "#/$defs/string_array"
        },
        "dossier_writes": {
          "$ref": "#/$defs/string_array"
        },
        "learning_ledger_rows": {
          "$ref": "#/$defs/nullable_string"
        },
        "mutation_gate": {
          "$ref": "#/$defs/nullable_string"
        },
        "no_learning_when": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "side_effect_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_only",
        "writes_allowed",
        "commit_allowed",
        "external_action_allowed"
      ],
      "properties": {
        "read_only": {
          "type": "boolean"
        },
        "writes_allowed": {
          "$ref": "#/$defs/string_array"
        },
        "commit_allowed": {
          "type": "boolean"
        },
        "external_action_allowed": {
          "type": "boolean"
        }
      }
    },
    "trace_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_fields",
        "fact_extraction_fields",
        "residual_routing"
      ],
      "properties": {
        "retained_fields": {
          "$ref": "#/$defs/string_array"
        },
        "fact_extraction_fields": {
          "$ref": "#/$defs/string_array"
        },
        "residual_routing": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_context",
        "available_artifacts",
        "model_dispatch",
        "provider_dispatch",
        "runtime_execution",
        "writes"
      ],
      "properties": {
        "available_context": {
          "$ref": "#/$defs/string_array"
        },
        "available_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "model_dispatch": {
          "type": "boolean"
        },
        "provider_dispatch": {
          "type": "boolean"
        },
        "runtime_execution": {
          "type": "boolean"
        },
        "writes": {
          "type": "boolean"
        }
      }
    },
    "dry_run": {
      "const": true
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "incomplete",
        "not_found",
        "invalid_json",
        "no_reasoning_contract",
        "invalid_contract"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        },
        "required": [
          "dry_run"
        ]
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "model_dispatch": {
                "const": false
              },
              "provider_dispatch": {
                "const": false
              },
              "runtime_execution": {
                "const": false
              },
              "writes": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ready",
              "blocked",
              "incomplete"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "role",
          "context_policy",
          "artifact_policy",
          "blocked_conditions",
          "blocked_if_present",
          "blocked_by",
          "freshness_requirements",
          "authority_requirements",
          "oracle_policy",
          "learning_policy",
          "side_effect_policy",
          "trace_policy"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocked_by": {
            "minItems": 1
          }
        },
        "required": [
          "blocked_by"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_found",
              "invalid_json",
              "no_reasoning_contract",
              "invalid_contract"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        },
        "required": [
          "issues"
        ]
      }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "code",
        "message"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "blocked_by_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_field",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "context_class",
            "artifact"
          ]
        },
        "class": {
          "$ref": "#/$defs/non_empty_string"
        },
        "artifact": {
          "$ref": "#/$defs/non_empty_string"
        },
        "source_field": {
          "$ref": "#/$defs/non_empty_string"
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "context_class"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "class"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "artifact"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "artifact"
            ]
          }
        }
      ]
    }
  }
}
