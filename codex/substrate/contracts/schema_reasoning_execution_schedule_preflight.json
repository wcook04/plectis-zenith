{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex/substrate/contracts/schema_reasoning_execution_schedule_preflight.json",
  "id": "schema_reasoning_execution_schedule_preflight",
  "artifact_kind": "contract",
  "version": "0.1",
  "status": "NORMATIVE",
  "description": "JSON Schema for reasoning_execution_schedule_preflight_v0, the dry-run demand-scoped schedule authorization report over reasoning_execution_replay_scope_v0 and candidate reasoning_execution_lineage_v0 records.",
  "purpose": "The schedule-preflight report converts replay impact into demand-scoped reuse, replay, skip, blocked, or invalid actions before any scheduler, launcher, provider router, fan-out runner, or dossier consumer acts. It is still no-dispatch/no-write IR.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_refs",
    "candidate_lineage",
    "replay_scope",
    "demand",
    "node_actions",
    "schedule",
    "authorization",
    "evaluation",
    "dry_run",
    "status",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "reasoning_execution_schedule_preflight_v0"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "candidate_lineage": {
      "$ref": "#/$defs/lineage_ref"
    },
    "replay_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_decision",
        "status"
      ],
      "properties": {
        "replay_decision": {
          "$ref": "#/$defs/nullable_string"
        },
        "status": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_node_ids",
        "target_artifact_kinds",
        "demand_closure_node_ids",
        "demand_basis"
      ],
      "properties": {
        "target_node_ids": {
          "$ref": "#/$defs/string_array"
        },
        "target_artifact_kinds": {
          "$ref": "#/$defs/string_array"
        },
        "demand_closure_node_ids": {
          "$ref": "#/$defs/string_array"
        },
        "demand_basis": {
          "enum": [
            "explicit_target_nodes",
            "explicit_artifact_kinds",
            "all_plan_outputs_default"
          ]
        }
      }
    },
    "node_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node_action"
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "replay_order_node_ids",
        "reuse_node_ids",
        "skipped_node_ids",
        "blocked_node_ids",
        "invalid_node_ids"
      ],
      "properties": {
        "policy": {
          "enum": [
            "deterministic_topological"
          ]
        },
        "replay_order_node_ids": {
          "$ref": "#/$defs/string_array"
        },
        "reuse_node_ids": {
          "$ref": "#/$defs/string_array"
        },
        "skipped_node_ids": {
          "$ref": "#/$defs/string_array"
        },
        "blocked_node_ids": {
          "$ref": "#/$defs/string_array"
        },
        "invalid_node_ids": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launch_authorized",
        "reason",
        "future_runner_requirements"
      ],
      "properties": {
        "launch_authorized": {
          "const": false
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "future_runner_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        }
      }
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    },
    "dry_run": {
      "const": true
    },
    "status": {
      "enum": [
        "ready",
        "no_op",
        "blocked",
        "invalid_schedule"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        },
        "required": [
          "dry_run"
        ]
      },
      "then": {
        "properties": {
          "evaluation": {
            "properties": {
              "model_dispatch": {
                "const": false
              },
              "provider_dispatch": {
                "const": false
              },
              "runtime_execution": {
                "const": false
              },
              "writes": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_schedule"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "schedule": {
            "properties": {
              "blocked_node_ids": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "nullable_string": {
      "type": [
        "string",
        "null"
      ]
    },
    "sha256_string": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_sha256_string": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256_string"
        },
        {
          "type": "null"
        }
      ]
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lineage_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage_id",
        "lineage_hash",
        "status"
      ],
      "properties": {
        "lineage_id": {
          "$ref": "#/$defs/nullable_string"
        },
        "lineage_hash": {
          "$ref": "#/$defs/nullable_sha256_string"
        },
        "status": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "context_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inject",
        "reference_only",
        "withhold",
        "forbidden",
        "available_context",
        "available_artifacts",
        "effective_context",
        "effective_artifacts"
      ],
      "properties": {
        "inject": {
          "$ref": "#/$defs/string_array"
        },
        "reference_only": {
          "$ref": "#/$defs/string_array"
        },
        "withhold": {
          "$ref": "#/$defs/string_array"
        },
        "forbidden": {
          "$ref": "#/$defs/string_array"
        },
        "available_context": {
          "$ref": "#/$defs/string_array"
        },
        "available_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "effective_context": {
          "$ref": "#/$defs/string_array"
        },
        "effective_artifacts": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "node_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "action",
        "reason",
        "upstream_node_ids",
        "context_lineage",
        "side_effect_level"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "action": {
          "enum": [
            "reuse",
            "replay",
            "skip_not_demanded",
            "blocked",
            "invalid"
          ]
        },
        "reason": {
          "$ref": "#/$defs/non_empty_string"
        },
        "upstream_node_ids": {
          "$ref": "#/$defs/string_array"
        },
        "context_lineage": {
          "$ref": "#/$defs/context_lineage"
        },
        "side_effect_level": {
          "enum": [
            "read_only",
            "local_write",
            "commit",
            "external_action"
          ]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_dispatch",
        "provider_dispatch",
        "runtime_execution",
        "writes"
      ],
      "properties": {
        "model_dispatch": {
          "type": "boolean"
        },
        "provider_dispatch": {
          "type": "boolean"
        },
        "runtime_execution": {
          "type": "boolean"
        },
        "writes": {
          "type": "boolean"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "path",
        "message",
        "witness"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/non_empty_string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "path": {
          "$ref": "#/$defs/non_empty_string"
        },
        "message": {
          "$ref": "#/$defs/non_empty_string"
        },
        "witness": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
