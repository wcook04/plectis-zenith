{
  "id": "news_frequency",
  "type": "config",
  "meta": {
    "standard": "std_tool_config",
    "description": "Unconfigured public NEWS lane; supply licensed channels and credentials locally."
  },
  "data": {
    "channels": {},
    "fetch": {
      "new_limit": 80,
      "max_bytes": 70000
    },
    "max_items": 140,
    "spam_filter": {
      "patterns": [
        "casino",
        "betting",
        "promo",
        "subscribe",
        "giveaway",
        "whitelist",
        "join",
        "discount",
        "jisou",
        "\u641c\u7d22\u5f15\u64ce",
        "withdraw",
        "disregard",
        "\u64a4\u92b7"
      ]
    },
    "execution": {
      "timeout": 60.0
    }
  }
}
