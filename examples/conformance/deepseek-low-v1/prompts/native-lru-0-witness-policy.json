    "parent_source": "def investigate(context, acquire):\n    capacity = context['capacity']\n    events = context['events']\n    cache = {}\n    lru_order = []\n    hits = 0\n    misses = 0\n    for event in events:\n        op = event['op']\n        if op == 'reset':\n            cache.clear()\n            lru_order.clear()\n            hits = 0\n            misses = 0\n        elif op == 'call':\n            key = event['key']\n            if key in cache:\n                hits += 1\n                lru_order.remove(key)\n                lru_order.append(key)\n            else:\n                misses += 1\n                if len(cache) >= capacity:\n                    lru_key = lru_order[0]\n                    cache.pop(lru_key)\n                    lru_order.pop(0)\n                cache[key] = True\n                lru_order.append(key)\n    size = len(cache)\n    return {'hits': hits, 'misses': misses, 'size': size}",
