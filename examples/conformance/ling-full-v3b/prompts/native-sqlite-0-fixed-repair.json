    "parent_source": "def investigate(context, acquire):\n    actions = context.get('actions', [])\n    present = set()\n    high = 0\n    open_txn = False\n    saved = None\n    for action in actions:\n        op = action.get('op')\n        if op == 'put':\n            ident = action.get('id')\n            present.add(ident)\n            if ident > high:\n                high = ident\n        elif op == 'delete':\n            ident = action.get('id')\n            if ident in present:\n                present.remove(ident)\n        elif op == 'begin':\n            open_txn = True\n            saved = (set(present), high)\n        elif op == 'commit':\n            open_txn = False\n            saved = None\n        elif op == 'rollback':\n            open_txn = False\n            if saved is not None:\n                present, high = saved\n                saved = None\n    return high + 1\n",
