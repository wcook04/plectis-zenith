    "parent_source": "def investigate(context, acquire):\n    capacity = context['capacity']\n    events = context['events']\n    order = []\n    present = set()\n    hits = 0\n    misses = 0\n    for event in events:\n        if event['op'] == 'reset':\n            order = []\n            present = set()\n            hits = 0\n            misses = 0\n        else:\n            key = event['key']\n            if key in present:\n                hits = hits + 1\n                order.remove(key)\n                order.append(key)\n            else:\n                misses = misses + 1\n                if len(order) == capacity:\n                    present.remove(order.pop(0))\n                order.append(key)\n                present.add(key)\n    return {'hits': hits, 'misses': misses, 'size': len(order)}\n",
