        "source": "def investigate(context, acquire):\n    events = context['events']\n    pending = []\n    count = 0\n    status = 'open'\n    for event in events:\n        op = event['op']\n        if op == 'reset':\n            pending = []\n            count = 0\n            status = 'open'\n            continue\n        if status != 'open':\n            return {'count': count, 'status': status}\n        if op == 'finish':\n            if len(pending) > 0:\n                status = 'error'\n            else:\n                status = 'finished'\n            continue\n        if op != 'feed':\n            return {'count': count, 'status': status}\n        stream = pending + list(event['bytes'])\n        pending = []\n        index = 0\n        limit = len(stream)\n        failed = False\n        while index < limit:\n            first = stream[index]\n            if first < 128:\n                count += 1\n                index += 1\n                continue\n            if first < 192 or first > 247:\n                failed = True\n                break\n            if first < 224:\n                width = 2\n                low = 128\n                high = 191\n            elif first < 240:\n                width = 3\n                if first == 224:\n                    low = 160\n                elif first == 237:\n                    high = 159\n                else:\n                    low = 128\n                high = 191\n            else:\n                width = 4\n                if first == 240:\n                    low = 144\n                elif first == 244:\n                    high = 143\n                else:\n                    low = 128\n                high = 191\n            if index + width > limit:\n                pending = stream[index:]\n                break\n            valid = True\n            for offset in range(1, width):\n                byte = stream[index + offset]\n                if byte < low or byte > high:\n                    valid = False\n                    break\n                if offset == 1 and width > 2:\n                    low = 128\n                    high = 191\n            if not valid:\n                failed = True\n                break\n            count += 1\n            index += width\n        if failed:\n            count = 0 if False else count\n            status = 'error'\n            pending = []\n    return {'count': count, 'status': status}\n",
