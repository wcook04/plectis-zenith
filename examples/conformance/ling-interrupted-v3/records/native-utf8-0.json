  "parent": {
    "source": "def investigate(context, acquire):\n    def make_decoder():\n        return {'pending': []}\n\n    def feed(decoder, data):\n        pending = decoder['pending']\n        stream = pending + list(data)\n        decoder['pending'] = []\n        index = 0\n        total = 0\n        limit = len(stream)\n        while index < limit:\n            first = stream[index]\n            if first < 128:\n                total += 1\n                index += 1\n                continue\n            if first < 192:\n                raise ValueError('invalid utf8')\n            if first < 224:\n                width = 2\n                low = 128\n                high = 191\n            elif first < 240:\n                width = 3\n                if first == 224:\n                    low = 160\n                elif first == 237:\n                    high = 159\n                else:\n                    low = 128\n                    high = 191\n            elif first < 248:\n                width = 4\n                if first == 240:\n                    low = 144\n                elif first == 244:\n                    high = 143\n                else:\n                    low = 128\n                    high = 191\n            else:\n                raise ValueError('invalid utf8')\n            if index + width > limit:\n                decoder['pending'] = stream[index:]\n                return total\n            valid = True\n            for offset in range(1, width):\n                byte = stream[index + offset]\n                if byte < low or byte > high:\n                    valid = False\n                    break\n                if offset == 1 and width > 2:\n                    low = 128\n                    high = 191\n            if not valid:\n                raise ValueError('invalid utf8')\n            total += 1\n            index += width\n        return total\n\n    def finish(decoder):\n        if decoder['pending']:\n            raise ValueError('incomplete utf8')\n        return 0\n\n    events = context['events']\n    decoder = make_decoder()\n    count = 0\n    status = 'open'\n    for event in events:\n        op = event['op']\n        if op == 'feed':\n            if status != 'open':\n                raise ValueError('illegal event')\n            count += feed(decoder, event['bytes'])\n        elif op == 'finish':\n            if status != 'open':\n                raise ValueError('illegal event')\n            count += finish(decoder)\n            status = 'finished'\n        elif op == 'reset':\n            decoder = make_decoder()\n            count = 0\n            status = 'open'\n        else:\n            raise ValueError('illegal event')\n    return {'count': count, 'status': status}\n",
    "scope": "Strict incremental UTF-8 decoder over feed/finish/reset events. Validates leading-byte ranges, continuation bytes, overlong encodings, surrogates, and code points above U+10FFFF; buffers incomplete prefixes across feeds; finish rejects pending bytes.",
