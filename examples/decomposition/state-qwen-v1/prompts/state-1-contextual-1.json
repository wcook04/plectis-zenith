        "source": "def compute_contribution(values):\n    contributions = []\n    for i in range(len(values)):\n        x = values[i]\n        p_x = 2 * x + 1 * (x ** 2) + 0 * (x ** 3)\n        if i == 0:\n            g_term = 0\n        else:\n            prev_sum = sum(values[:i])\n            g_term = 1 * x * prev_sum\n        total_contrib = p_x + g_term\n        contributions.append(total_contrib)\n    return contributions\n\ndef apply_cumulative_passes(contributions, num_passes=4):\n    result = list(contributions)\n    for _ in range(num_passes):\n        new_result = []\n        running_sum = 0\n        for val in result:\n            running_sum += val\n            new_result.append(running_sum)\n        result = new_result\n    return result[-1] if result else 0\n\ndef investigate(context, acquire):\n    values = context.get(\"values\", [])\n    if not values:\n        return 0\n    contribs = compute_contribution(values)\n    final_value = apply_cumulative_passes(contribs, 4)\n    return final_value",
