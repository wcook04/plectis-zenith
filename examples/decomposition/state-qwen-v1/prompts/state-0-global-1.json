        "source": "def investigate(context, acquire):\n    values = context.get(\"values\", [])\n    if not values:\n        return 0\n    \n    # Determine parameters based on calibration and development examples\n    # From analysis: p(x) = x^2 + 2x (a=2, b=1, c=0)\n    # g = 1, using immediately preceding value for interaction term\n    # Number of cumulative sum passes = 3\n    \n    def compute_contribution_list(vals):\n        contributions = []\n        prev_val = 0\n        for i in range(len(vals)):\n            x = vals[i]\n            # Polynomial part: p(x) = 2*x + 1*x*x + 0*x*x*x\n            poly_part = 2 * x + x * x\n            \n            # Interaction part: g * x * prev_val where g=1\n            inter_part = x * prev_val\n            \n            total_contrib = poly_part + inter_part\n            contributions.append(total_contrib)\n            \n            # Update previous value for next iteration\n            prev_val = x\n            \n        return contributions\n\n    def apply_cumulative_sum_passes(lst, num_passes):\n        current_lst = lst[:]\n        for _ in range(num_passes):\n            new_lst = []\n            running_sum = 0\n            for val in current_lst:\n                running_sum += val\n                new_lst.append(running_sum)\n            current_lst = new_lst\n        return current_lst\n\n    contribs = compute_contribution_list(values)\n    final_vals = apply_cumulative_sum_passes(contribs, 3)\n    \n    return final_vals[-1] if final_vals else 0",
