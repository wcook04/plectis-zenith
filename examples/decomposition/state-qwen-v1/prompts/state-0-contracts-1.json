        "source": "def compute_contribution_list(values):\n    contributions = []\n    for i in range(len(values)):\n        x = values[i]\n        # Polynomial part: p(x) = a*x + b*x^2 + c*x^3\n        poly_part = 1 * x + 1 * (x ** 2) + 0 * (x ** 3)\n        \n        # Interaction term: g * x * prev_value or sum_of_preceding_values\n        interaction_term = 0\n        if i > 0:\n            # Try both options and see which fits better based on examples\n            prev_val = values[i - 1]\n            sum_prev_vals = sum(values[:i])\n            \n            # Based on analysis, it seems like using the immediate previous value works best\n            interaction_term = 1 * x * prev_val\n        \n        total_contribution = poly_part + interaction_term\n        contributions.append(total_contribution)\n    return contributions\n\ndef apply_cumulative_sum_passes(contributions, num_passes):\n    result = list(contributions)\n    for _ in range(num_passes):\n        new_result = []\n        running_sum = 0\n        for val in result:\n            running_sum += val\n            new_result.append(running_sum)\n        result = new_result\n    return result\n\ndef readout(final_values):\n    if not final_values:\n        return 0\n    return final_values[-1]\n\ndef investigate(context, acquire):\n    values = context[\"values\"]\n    if not values:\n        return 0\n    \n    contributions = compute_contribution_list(values)\n    final_values = apply_cumulative_sum_passes(contributions, 2)\n    return readout(final_values)",
