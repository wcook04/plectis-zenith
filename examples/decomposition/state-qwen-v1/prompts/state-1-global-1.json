        "source": "def investigate(context, acquire):\n    values = context.get(\"values\", [])\n    if not values:\n        return 0\n    n = len(values)\n    # Step 1: Compute contributions c[i] based on inferred parameters\n    # Inferred from calibration and development examples:\n    # Polynomial p(x) = x + 2x^2 (a=1, b=2, c=0)\n    # g = 1, using immediately preceding value\n    # So contribution at position i is:\n    #   c[i] = p(values[i]) + g * values[i] * prev_value\n    # where prev_value = values[i-1] if i > 0 else 0\n    # Thus: c[i] = values[i] + 2*values[i]**2 + values[i]*prev_value\n    \n    contributions = []\n    for i in range(n):\n        x = values[i]\n        prev_x = values[i - 1] if i > 0 else 0\n        poly_part = x + 2 * x ** 2\n        cross_part = x * prev_x\n        contrib = poly_part + cross_part\n        contributions.append(contrib)\n    \n    # Step 2: Apply cumulative sum passes\n    # From analysis of expected outputs vs computed single-pass results,\n    # it appears that two cumulative sum passes are applied.\n    # First pass: s1[i] = sum(contributions[0..i])\n    # Second pass: s2[i] = sum(s1[0..i])\n    # Return last element of second pass\n    \n    # Perform first cumulative sum\n    cumsum1 = []\n    total = 0\n    for val in contributions:\n        total += val\n        cumsum1.append(total)\n    \n    # Perform second cumulative sum\n    cumsum2 = []\n    total = 0\n    for val in cumsum1:\n        total += val\n        cumsum2.append(total)\n    \n    return cumsum2[-1]",
