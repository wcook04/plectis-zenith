        "source": "def summarize_values(values):\n    n = len(values)\n    if n == 0:\n        return 0\n    contrib = []\n    for i in range(n):\n        x = values[i]\n        p = 2*x + 0*x*x + 0*x*x*x\n        g = 0\n        if i > 0:\n            g = 0\n        contrib.append(p + g*x)\n    for _ in range(2):\n        total = 0\n        for i in range(n):\n            total = total + contrib[i]\n            contrib[i] = total\n    return contrib[n-1]\n\ndef readout(summary):\n    return summary\n\ndef investigate(context, acquire):\n    return readout(summarize_values(context[\"values\"]))\n",
