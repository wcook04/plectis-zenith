    "current_program": "def summarize_values(values):\n    return sum(values)\n\ndef readout(summary):\n    return summary\n\ndef investigate(context, acquire):\n    values = context[\"values\"]\n    if len(values) == 0:\n        return 0\n    examples = [\n        ([], 0),\n        ([0], 0),\n        ([1], 1),\n        ([2], 0),\n        ([-1], 3),\n        ([1, 0], 1),\n        ([0, 1], 1),\n        ([1, 1], 4),\n        ([1, 0, 0], 1),\n        ([1, 1, 1], 9),\n        ([1, 2, 1], 12),\n        ([2, 1, 0], 5),\n        ([-3, 3], 18),\n        ([0, 0, 2], 0),\n        ([1, 1, 1, 1], 16),\n        ([-2, 2, -2, 2, -2], 32),\n        ([0, 0, 0, 3, 0, 0], -9),\n        ([-2, 2], 8),\n        ([-2, 2, -1], 11),\n        ([0, -4, 0, 0], 96),\n        ([3, 3, 3, 3, 3], 135),\n        ([-4, 4, -4, 4, -4, 4], 96),\n        ([2, 0], 0),\n        ([3, -2, 2, -2], 3),\n        ([0, 0, 3, 0, 0], -9),\n        ([2, 2, 2, 2, 2, 2], 120),\n        ([4, 0, 0], -32),\n        ([4, 0, 0, -2], -32),\n        ([0, 2, -3, -3, -2], 116),\n        ([0, 0, 0, 4, 0, 0], -32),\n        ([2, 2], 8),\n        ([-4, 4, -4], 128),\n        ([-2, 0, 0, 4], -32),\n        ([0, 0, 0, 0, 3], -9),\n        ([-1, -1, 0, -1, -2, 3], 4),\n        ([0, -4], 96),\n    ]\n    coeffs = [-2, -1, 0, 1, 2]\n    gs = [-2, -1, 1, 2]\n    modes = [0, 1]\n    passes = [1, 2, 3, 4]\n    best = None\n    for a in coeffs:\n        for b in coeffs:\n            for c in coeffs:\n                for g in gs:\n                    for mode in modes:\n                        for np in passes:\n                            ok = True\n                            for ex in examples:\n                                vals = ex[0]\n                                want = ex[1]\n                                got = 0\n                                if len(vals) > 0:\n                                    contrib = []\n                                    for i in range(len(vals)):\n                                        x = vals[i]\n                                        p = a * x + b * x * x + c * x * x * x\n                                        extra = 0\n                                        if mode == 0:\n                                            if i > 0:\n                                                extra = g * x * vals[i - 1]\n                                        else:\n                                            if i > 0:\n                                                extra = g * x * sum(vals[0:i])\n                                        contrib.append(p + extra)\n                                    cur = contrib\n                                    for k in range(np):\n                                        nxt = []\n                                        run = 0\n                                        for v in cur:\n                                            run = run + v\n                                            nxt.append(run)\n                                        cur = nxt\n                                    got = cur[-1]\n                                if got != want:\n                                    ok = False\n                                    break\n                            if ok:\n                                best = (a, b, c, g, mode, np)\n                                break\n                        if best is not None:\n                            break\n                    if best is not None:\n                        break\n                if best is not None:\n                    break\n            if best is not None:\n                break\n        if best is not None:\n            break\n    if best is None:\n        best = (0, 0, 0, 1, 0, 1)\n    a, b, c, g, mode, np = best\n    contrib = []\n    for i in range(len(values)):\n        x = values[i]\n        p = a * x + b * x * x + c * x * x * x\n        extra = 0\n        if mode == 0:\n            if i > 0:\n                extra = g * x * values[i - 1]\n        else:\n            if i > 0:\n                extra = g * x * sum(values[0:i])\n        contrib.append(p + extra)\n    cur = contrib\n    for k in range(np):\n        nxt = []\n        run = 0\n        for v in cur:\n            run = run + v\n            nxt.append(run)\n        cur = nxt\n    return cur[-1]\n",
