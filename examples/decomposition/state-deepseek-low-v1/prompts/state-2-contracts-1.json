        "source": "def poly(x, a, b, c):\n    return a * x + b * x * x + c * x * x * x\n\ndef contributions(values, a, b, c, g, mode):\n    out = []\n    total = 0\n    for i in range(len(values)):\n        x = values[i]\n        base = poly(x, a, b, c)\n        if i == 0:\n            extra = 0\n        elif mode == 0:\n            extra = g * x * values[i - 1]\n        else:\n            extra = g * x * total\n        out.append(base + extra)\n        total = total + x\n    return out\n\ndef passes(seq, n):\n    cur = seq\n    for _ in range(n):\n        nxt = []\n        run = 0\n        for v in cur:\n            run = run + v\n            nxt.append(run)\n        cur = nxt\n    return cur\n\ndef evaluate(values, a, b, c, g, mode, n):\n    if not values:\n        return 0\n    return passes(contributions(values, a, b, c, g, mode), n)[-1]\n\ndef investigate(context, acquire):\n    values = context[\"values\"]\n    if not values:\n        return 0\n    best = None\n    best_err = None\n    for a in (-2, -1, 0, 1, 2):\n        for b in (-2, -1, 0, 1, 2):\n            for c in (-2, -1, 0, 1, 2):\n                for g in (-2, -1, 1, 2):\n                    for mode in (0, 1):\n                        for n in (1, 2, 3, 4):\n                            val = evaluate(values, a, b, c, g, mode, n)\n                            err = abs(val - 0)\n                            if best is None or err < best_err:\n                                best = (a, b, c, g, mode, n)\n                                best_err = err\n    return evaluate(values, best[0], best[1], best[2], best[3], best[4], best[5])\n",
