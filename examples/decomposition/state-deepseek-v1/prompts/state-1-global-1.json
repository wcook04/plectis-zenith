      {
        "change": "Replaced the sum readout with a search over the specified finite family: polynomial coefficients a,b,c in {-2,-1,0,1,2}, optional g*x times previous value or previous sum with g in {-2,-1,1,2}, and 1..4 cumulative-sum passes. The program enumerates all candidates, scores them against the calibration and development examples, and returns the prediction of the best-scoring candidate.",
        "scope": "Implements the full synthetic integer sequence family described in the task, including polynomial contribution, optional preceding-value or preceding-sum coupling, and cumulative-sum passes. Uses the provided measured examples as the selection criterion.",
        "source": "def poly_value(a, b, c, x):\n    return a * x + b * x * x + c * x * x * x\n\ndef make_contrib(values, a, b, c, mode, g):\n    out = []\n    running = 0\n    for i in range(len(values)):\n        x = values[i]\n        v = poly_value(a, b, c, x)\n        if mode == 1 and i > 0:\n            v = v + g * x * values[i - 1]\n        if mode == 2:\n            v = v + g * x * running\n        out.append(v)\n        running = running + x\n    return out\n\ndef cumsum_pass(seq):\n    out = []\n    total = 0\n    for v in seq:\n        total = total + v\n        out.append(total)\n    return out\n\ndef apply_passes(seq, passes):\n    cur = seq\n    for _ in range(passes):\n        cur = cumsum_pass(cur)\n    return cur\n\ndef predict(values, params):\n    a, b, c, mode, g, passes = params\n    contrib = make_contrib(values, a, b, c, mode, g)\n    result = apply_passes(contrib, passes)\n    if len(result) == 0:\n        return 0\n    return result[-1]\n\ndef all_params():\n    params = []\n    coeffs = [-2, -1, 0, 1, 2]\n    gs = [-2, -1, 1, 2]\n    for a in coeffs:\n        for b in coeffs:\n            for c in coeffs:\n                for mode in [0, 1, 2]:\n                    if mode == 0:\n                        params.append((a, b, c, mode, 0, 1))\n                        params.append((a, b, c, mode, 0, 2))\n                        params.append((a, b, c, mode, 0, 3))\n                        params.append((a, b, c, mode, 0, 4))\n                    else:\n                        for g in gs:\n                            params.append((a, b, c, mode, g, 1))\n                            params.append((a, b, c, mode, g, 2))\n                            params.append((a, b, c, mode, g, 3))\n                            params.append((a, b, c, mode, g, 4))\n    return params\n\ndef score_params(params, examples):\n    score = 0\n    for ex in examples:\n        values = ex[0]\n        expected = ex[1]\n        got = predict(values, params)\n        if got == expected:\n            score = score + 1\n    return score\n\ndef investigate(context, acquire):\n    values = context[\"values\"]\n    examples = [\n        ([], 0),\n        ([0], 0),\n        ([1], 5),\n        ([2], 26),\n        ([-1], -1),\n        ([1, 0], 15),\n        ([0, 1], 5),\n        ([1, 1], 20),\n        ([1, 0, 0], 30),\n        ([1, 1, 1], 50),\n        ([1, 2, 1], 113),\n        ([2, 1, 0], 171),\n        ([1, -2], 5),\n        ([0, 0, 3], 75),\n        ([-1, -1, -1, -1], -20),\n        ([-3, 3, -3, 3, -3], 117),\n        ([3, 0, 0, 2, 0, 0], 1731),\n        ([1, 3], 90),\n        ([-3, 2, -3], -195),\n        ([2, 0, 0, 0], 260),\n        ([2, 2, 2, 2, 2], 910),\n        ([-2, 2, -2, 2, -2, 2], 232),\n        ([-2, 0], -30),\n        ([1, 0, 2], 56),\n        ([2, 0, 2, 0], 338),\n        ([3, 0, 0, 0, 0], 1125),\n        ([-2, -2, -2, -2, -2, -2], -560),\n        ([-2, 2], -4),\n        ([-4, 0, 0], -600),\n        ([-4, 0, 0, 3], -925),\n        ([2, 0, 0, -1, -2], 377),\n        ([0, 0, 0, 0, -3, 0], -117),\n        ([-1, -1], -4),\n        ([-2, 2, -2], 8),\n        ([-1, 0, 0, -2], -20),\n        ([2, 0, 0, 0, -3], 351),\n    ]\n    best = None\n    best_score = -1\n    for params in all_params():\n        s = score_params(params, examples)\n        if s > best_score:\n            best_score = s\n            best = params\n    return predict(values, best)\n",
