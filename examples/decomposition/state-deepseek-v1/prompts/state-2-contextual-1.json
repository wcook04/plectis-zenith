        "source": "def poly(x, a, b, c):\n    return a * x + b * x * x + c * x * x * x\n\ndef contributions(values, a, b, c, g, mode):\n    out = []\n    total = 0\n    prev = 0\n    for x in values:\n        base = poly(x, a, b, c)\n        if mode == 0:\n            base = base + g * x * prev\n        else:\n            base = base + g * x * total\n        out.append(base)\n        total = total + x\n        prev = x\n    return out\n\ndef passes(contribs, n):\n    cur = contribs\n    for _ in range(n):\n        acc = 0\n        nxt = []\n        for v in cur:\n            acc = acc + v\n            nxt.append(acc)\n        cur = nxt\n    return cur\n\ndef evaluate(values, a, b, c, g, mode, n):\n    if not values:\n        return 0\n    return passes(contributions(values, a, b, c, g, mode), n)[-1]\n\ndef investigate(context, acquire):\n    values = context[\"values\"]\n    if not values:\n        return 0\n    best = None\n    best_err = None\n    for a in (-2, -1, 0, 1, 2):\n        for b in (-2, -1, 0, 1, 2):\n            for c in (-2, -1, 0, 1, 2):\n                for g in (-2, -1, 1, 2):\n                    for mode in (0, 1):\n                        for n in (1, 2, 3, 4):\n                            err = 0\n                            for probe in acquire():\n                                pv = probe[\"values\"]\n                                if pv:\n                                    got = evaluate(pv, a, b, c, g, mode, n)\n                                    err = err + abs(got - probe[\"expected\"])\n                            if best_err is None or err < best_err:\n                                best_err = err\n                                best = (a, b, c, g, mode, n)\n    a, b, c, g, mode, n = best\n    return evaluate(values, a, b, c, g, mode, n)\n",
