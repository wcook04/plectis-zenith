  "decisions": {
    "adopt": [
      "retained executable alternatives and raw observations",
      "reusable failure experiments with freshly measured source labels",
      "dependency-aware retraction under explicit scope contracts",
      "separate search-state and serving-program rules",
      "useful-workload and acquired-capability gate"
    ],
    "defer": [
      "integrating overlapping returned runtime libraries",
      "expanded disclosed-family campaign",
      "mandatory graph or specialized memory index",
      "learned scheduler and recursive-self-improvement claims"
    ],
    "reject": [
      "current-answer equivalence as permanent program equivalence",
      "passing canary as universal completeness",
      "independent marginal fits as unconditional joint support",
      "authored mechanism witness as model-acquisition evidence"
    ]
  }
}
